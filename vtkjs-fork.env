# The vtk.js build every artifact in this fork's chain is compiled against.
#
# A branch is not a build input: it moves, so the same release command would
# embed a different vtk.js over time and two wheels with the same version could
# disagree. The commit is the input; the branch only records where to find it.
#
# This is the only place the sha exists. release.sh, verify_chain.py,
# .github/workflows/build-fork-wheel.yml and README.rst all read it from here.
VTKJS_FORK_REPO=https://github.com/PaulHax/vtk-js.git
VTKJS_FORK_BRANCH=external-context-integration
VTKJS_FORK_COMMIT=7da93a19ce8f1ff0dc3070acd8d913dd4c473544
